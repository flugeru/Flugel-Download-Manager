{
  "manifest_version": 3,
  "name": "Flugel Download Manager",
  "version": "2.2.3",
  "description": "Send links and detected media to Flugel Download Manager for user-confirmed download. Respects browser permissions; protected streams are never bypassed.",
"permissions": ["contextMenus", "nativeMessaging", "storage", "scripting", "activeTab", "tabs", "webRequest", "cookies", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_title": "Flugel Download Manager",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {}
}

<Application x:Class="Harbor.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172D46" />
    <SolidColorBrush x:Key="Muted" Color="#52647A" />
    <SolidColorBrush x:Key="Accent" Color="#087E85" />
    <SolidColorBrush x:Key="Line" Color="#DBE3EA" />
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="#F4F7FA" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,0,5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,18,0" />
      <Setter Property="Padding" Value="5,5,0,5" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#EEF3F7" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Padding" Value="12,12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="DetailText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="0,3" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Application.Resources>
</Application>

<Application x:Class="Flugel.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#172D46" />
    <SolidColorBrush x:Key="Muted" Color="#52647A" />
    <SolidColorBrush x:Key="Accent" Color="#087E85" />
    <SolidColorBrush x:Key="AccentDark" Color="#065A60" />
    <SolidColorBrush x:Key="Line" Color="#DBE3EA" />
    <SolidColorBrush x:Key="PageBg" Color="#F4F7FA" />
    <SolidColorBrush x:Key="SidebarBg" Color="#EDF2F6" />
    <SolidColorBrush x:Key="Danger" Color="#9B283B" />
    <SolidColorBrush x:Key="OkGreen" Color="#1E7A46" />
    <SolidColorBrush x:Key="WarnAmber" Color="#9A6500" />

    <!-- Independent vector glyphs (no original artwork). -->
    <Path x:Key="GlyphAdd" Data="M12,3 L12,21 M3,12 L21,12" Stroke="Black" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    <Path x:Key="GlyphPlay" Data="M6,4 L20,12 L6,20 Z" Fill="Black" />
    <Path x:Key="GlyphPause" Data="M7,4 L11,4 L11,20 L7,20 Z M13,4 L17,4 L17,20 L13,20 Z" Fill="Black" />
    <Path x:Key="GlyphTrash" Data="M5,7 L19,7 M9,7 L9,4 L15,4 L15,7 M7,7 L8,20 L16,20 L17,7" Stroke="Black" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
    <Path x:Key="GlyphUp" Data="M12,19 L12,6 M6,12 L12,6 L18,12" Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    <Path x:Key="GlyphDown" Data="M12,6 L12,19 M6,13 L12,19 L18,13" Stroke="Black" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    <Path x:Key="GlyphSettings" Data="M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 M12,2 L13,5 L11,5 Z M12,22 L13,19 L11,19 Z M2,12 L5,13 L5,11 Z M22,12 L19,11 L19,13 Z" Stroke="Black" StrokeThickness="1.6" Fill="Transparent" />
    <Path x:Key="GlyphFolder" Data="M3,6 L9,6 L11,8 L21,8 L21,19 L3,19 Z" Stroke="Black" StrokeThickness="1.7" Fill="Transparent" />
    <Path x:Key="GlyphSearch" Data="M11,4 A7,7 0 1,0 11,18 A7,7 0 1,0 11,4 M16,16 L21,21" Stroke="Black" StrokeThickness="1.8" StrokeStartLineCap="Round" Fill="Transparent" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource PageBg}" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0,0,0,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="Padding" Value="4,4,0,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="28" />
    </Style>
    <Style TargetType="Menu">
      <Setter Property="Background" Value="#EEF3F7" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="0,2" />
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style TargetType="ToolBar">
      <Setter Property="Background" Value="#EEF3F7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,5" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#E8EEF4" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Padding" Value="4,5" />
    </Style>
    <Style x:Key="DetailText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style x:Key="SidebarItem" TargetType="RadioButton">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
    </Style>
  </Application.Resources>
</Application>
